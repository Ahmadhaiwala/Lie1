# Crawl4AI Configuration
CRAWL4AI_VERBOSE=True
CRAWL4AI_MAX_CONCURRENT=5

# Browser Settings
BROWSER_HEADLESS=True
BROWSER_TIMEOUT=30000

# LLM Configuration - OpenRouter
OPENROUTER_API_KEY=your-openrouter-api-key-here
DEFAULT_MODEL=meta-llama/llama-3.2-3b-instruct:free
LLM_TEMPERATURE=0.7
LLM_MAX_TOKENS=4096

# Lead-discovery search (SerpApi is preferred; Google Places is the fallback).
# SERPAPI_API_KEY is also accepted for compatibility with SerpApi's naming.
SERP_API_KEY=your-serpapi-key-here
GOOGLE_MAPS_API_KEY=your-google-maps-api-key-here

# ── Geographic Targeting Configuration ──────────────────────────────────────

# Target location for lead discovery (defaults to Ahmedabad, India)
DEFAULT_LOCATION_NAME=Ahmedabad, Gujarat, India
DEFAULT_LOCATION_CITY=Ahmedabad
DEFAULT_LOCATION_STATE=Gujarat
DEFAULT_LOCATION_COUNTRY=India
DEFAULT_LOCATION_LAT=23.0225
DEFAULT_LOCATION_LNG=72.5714
DEFAULT_SEARCH_RADIUS_KM=20

# Examples for other cities:
# Mumbai: DEFAULT_LOCATION_LAT=19.0760, DEFAULT_LOCATION_LNG=72.8777
# Delhi: DEFAULT_LOCATION_LAT=28.7041, DEFAULT_LOCATION_LNG=77.1025
# Bangalore: DEFAULT_LOCATION_LAT=12.9716, DEFAULT_LOCATION_LNG=77.5946

# ── Lead Generation Automation ──────────────────────────────────────────────

# Your agency identity (used in outreach messages)
AGENCY_NAME=YourAgency
AGENCY_WEBSITE=https://youragency.com
SENDER_NAME=Ahmad
SENDER_WHATSAPP=+1234567890

# Scheduler
LOG_DIR=logs

# Optional: Webhook URL to POST a JSON summary after each run
# NOTIFY_WEBHOOK_URL=https://hooks.slack.com/services/xxx/yyy/zzz
