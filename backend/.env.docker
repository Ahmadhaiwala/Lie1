# Docker Environment Variables for LeadBot Backend
# This file is used when running in Docker containers

# LLM Configuration - Ollama (running in separate container)
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://ollama:11434/v1
DEFAULT_MODEL=llama3
LLM_TEMPERATURE=0.7
LLM_MAX_TOKENS=2048

# Crawl4AI Configuration
CRAWL4AI_VERBOSE=True
CRAWL4AI_MAX_CONCURRENT=5

# Browser Settings (runs inside Docker, no subprocess issues)
BROWSER_HEADLESS=True
BROWSER_TIMEOUT=30000

# Lead Generation Automation
AGENCY_NAME=LeadBot AI
AGENCY_WEBSITE=https://leadbot.ai
SENDER_NAME=LeadBot Team
SENDER_WHATSAPP=+92-300-0000000

# Scheduler
LOG_DIR=logs

# CORS Origins (allow localhost + Docker internal)
CORS_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:3000,http://frontend:5174

# Python Settings
PYTHONUNBUFFERED=1
PYTHONDONTWRITEBYTECODE=1
